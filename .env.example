# 달새김사주 환경변수 — 운영 값은 Railway 서비스 변수에만 넣는다(채팅·코드·파일에 붙이지 않기)
APP_ENV=development
SITE_ID=dalsaegim               # 사이트 구분값(2호 사이트는 다른 값)
MOCK_MODE=true                  # 서버: true 면 결제·로그인을 가짜로 처리(시연·테스트용). 오픈 때 false
DATABASE_URL=                   # 비우면 내장 PGlite(로컬). 운영은 Railway PostgreSQL
PUBLIC_WEB_ORIGIN=              # 예) https://www.도메인
API_ORIGIN=                     # 예) https://api.도메인  (웹 빌드에도 같은 값)
ADMIN_EMAIL=                    # 첫 배포 때 최고관리자 1명 자동 생성
ADMIN_INIT_PASSWORD=            # 10자 이상, 로그인 후 관리자 계정 메뉴에서 바로 변경
JWT_SECRET=                     # 긴 무작위 문자열
# AI — 유료 풀이·달빛 상담·편지. Claude(Anthropic) 또는 GPT(OpenAI) 중 키가 있는 쪽을 쓴다(10/24). 키가 없으면 계산 결과로 만든 풀이·짧은 답변
OPENAI_API_KEY=                 # GPT 키(인수 대표님 — platform.openai.com). 이것만 있으면 GPT 로 동작
ANTHROPIC_API_KEY=              # Claude 키. 둘 다 있으면 AI_PROVIDER 로 고름(기본 Claude)
AI_PROVIDER=                    # (선택) openai 또는 anthropic
AI_MODEL=                       # 유료 풀이 모델. 비우면 GPT gpt-6.1-sol / Claude claude-sonnet-5-5 (둘 다 $2/$10)
FRIEND_MODEL=                   # 달빛 상담 이용권 질문 모델. 비우면 AI_MODEL
FRIEND_MODEL_FREE=              # 무료 상담 모델. 비우면 GPT gpt-6-luna / Claude claude-haiku-5-5 (둘 다 $0.10/$0.50)
AI_REASONING=                   # (GPT 만) 생각 깊이 low|medium|high. 비우면 low(빠르고 싸게)
ANTHROPIC_MODEL=                # (예전 이름, Claude 일 때 AI_MODEL 대신 써도 됨)
OPENAI_MODEL=                   # (GPT 일 때 AI_MODEL 대신 써도 됨)
READING_AI=                     # live 일 때만 유료 풀이에 AI 사용
READING_LONG=                   # 정통사주 A4 40장 장편(기본 켜짐, off 면 9장). AI 가 켜져 있을 때만 — 1건 약 1,000~1,800원·3~6분
READING_LEN_SCALE=              # 장편 분량 배율(기본 0.82 ≈ A4 40~46장). 0.7 이면 약 36장
READING_CONCURRENCY=            # 장편 묶음 동시 호출 수(기본 4)
READING_LONG_MODEL=             # (선택) 장편만 다른 모델로. 비우면 AI_MODEL
PDF_FONT_DIR=                   # (선택) A4 PDF 한글 글꼴 폴더. 비우면 /usr/share/fonts/opentype/noto (서버 이미지에 포함)
FRIEND_AI=                      # live 일 때만 AI 사주친구에 AI 사용(비우면 READING_AI 따름)
AI_PRICE_IN_PER_M=2             # 원가 표시용(USD / 100만 토큰) — Sonnet 5.5 기준 입력 2 · 출력 10 (2026-10 공식 요금표)
AI_PRICE_OUT_PER_M=10
ALLOW_ENGINE_READING=           # true 면 AI 없이도 유료 판매 허용(권장하지 않음)
# 결제 — PayApp(판매자 관리자 → 설정 → 연동정보)
PG_PROVIDER=payapp
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# 간편 로그인 — 콘솔 등록 후 입력. 없으면(MOCK) 테스트 로그인
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TTS=                            # live 일 때만 자연 음성. 비우면 브라우저 내장 음성
TYPECAST_API_KEY=               # 타입캐스트 API 키(대표님 계정, Lite 이상 — 무료 요금제 음성은 상업적 사용 불가). 있으면 구글보다 먼저 사용
TYPECAST_VOICE_YEONHWA=         # 상담사별 타입캐스트 목소리 고정(선택, tc_xxx) — HARIN·SEOYEON·YEONHWA·BAKSA·CHEONGUN·JUNHO. 비우면 성별·나이대로 자동 선택
TTS_PROVIDER=                   # (선택) google 또는 typecast 로 강제
GOOGLE_TTS_KEY=                 # 구글 클라우드 API 키(Text-to-Speech API 사용 설정)
TTS_VOICE_F=                    # 비우면 ko-KR-Chirp3-HD-Aoede
TTS_VOICE_M=                    # 비우면 ko-KR-Chirp3-HD-Charon
TTS_VOICE_HARIN=                # 상담사별 목소리 바꾸기(선택) — HARIN(서월)·SEOYEON·YEONHWA·BAKSA·CHEONGUN·JUNHO. 비우면 server/src/services/tts.ts 기본값
KAKAO_JS_KEY=                   # 카카오톡 공유(웹 도메인 등록 필요)
PGLITE_DIR=
DEMO_DATA=false
PORT=8791
