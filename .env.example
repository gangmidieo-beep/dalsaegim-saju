# 달새김사주 환경변수 — 운영 값은 Railway 서비스 변수에만 넣는다(채팅·코드·파일에 붙이지 않기)
APP_ENV=development
SITE_ID=dalsaegim               # 사이트 구분값(2호 사이트는 다른 값)
MOCK_MODE=true                  # 서버: true 면 결제·로그인을 가짜로 처리(시연·테스트용). 오픈 때 false
DATABASE_URL=                   # 비우면 내장 PGlite(로컬). 운영은 Railway PostgreSQL
PUBLIC_WEB_ORIGIN=              # 예) https://www.도메인
API_ORIGIN=                     # 예) https://api.도메인  (웹 빌드에도 같은 값)
ADMIN_EMAIL=                    # 첫 배포 때 최고관리자 1명 자동 생성
ADMIN_INIT_PASSWORD=            # 10자 이상, 로그인 후 관리자 계정 메뉴에서 바로 변경
JWT_SECRET=                     # 긴 무작위 문자열
# AI — 유료 풀이·AI 사주친구. 키가 없으면 계산 결과로 만든 엔진 풀이·짧은 답변으로 동작
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                # 유료 풀이 모델
FRIEND_MODEL=                   # AI 사주친구 모델(비우면 ANTHROPIC_MODEL)
READING_AI=                     # live 일 때만 유료 풀이에 AI 사용
FRIEND_AI=                      # live 일 때만 AI 사주친구에 AI 사용(비우면 READING_AI 따름)
AI_PRICE_IN_PER_M=3             # 원가 표시용(USD / 100만 토큰)
AI_PRICE_OUT_PER_M=15
ALLOW_ENGINE_READING=           # true 면 AI 없이도 유료 판매 허용(권장하지 않음)
# 결제 — PayApp(판매자 관리자 → 설정 → 연동정보)
PG_PROVIDER=payapp
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# 간편 로그인 — 콘솔 등록 후 입력. 없으면(MOCK) 테스트 로그인
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_JS_KEY=                   # 카카오톡 공유(웹 도메인 등록 필요)
PGLITE_DIR=
DEMO_DATA=false
PORT=8791
